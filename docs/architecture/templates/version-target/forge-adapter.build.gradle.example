plugins {
    id 'base'
}

description = 'Forge @FORGE_VERSION@ / Minecraft @MC_VERSION@ platform adapter.'

tasks.register('verifyAdapterLayout') {
    group = 'verification'
    inputs.files(fileTree('src/main/java') { include '**/*.java' })
    doLast {
        if (inputs.files.files.isEmpty()) {
            throw new GradleException(
                    'Forge adapter must implement the existing feature Ports.'
            )
        }
    }
}

tasks.named('check') {
    dependsOn tasks.named('verifyAdapterLayout')
}
