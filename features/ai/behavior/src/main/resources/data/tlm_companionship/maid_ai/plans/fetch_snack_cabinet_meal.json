{
  "format_version": 2,
  "initial_state": "fetch",
  "resume_policy": "restart_step",
  "maximum_suspend_ticks": 600,
  "states": {
    "fetch": {
      "action": "tlm_companionship:action/fetch_snack_cabinet_meal",
      "parameters": {
        "speed": "0.55",
        "close_distance": "2"
      },
      "timeout_ticks": 200,
      "on_success": "$success",
      "on_failure": "$failure",
      "on_cancel": "$failure"
    }
  }
}
