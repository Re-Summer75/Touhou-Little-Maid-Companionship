{
  "format_version": 1,
  "initial_state": "approach",
  "states": {
    "approach": {
      "action": "tlm_companionship:action/approach_owner",
      "parameters": {
        "speed": "0.55",
        "close_distance": "2"
      },
      "timeout_ticks": 200,
      "on_success": "request",
      "on_failure": "$failure"
    },
    "request": {
      "action": "tlm_companionship:action/request_hunger_attention",
      "timeout_ticks": 20,
      "on_success": "$success",
      "on_failure": "$failure"
    }
  }
}
